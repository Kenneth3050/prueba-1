{
  "name": "cubo",
  "version": "1.7.0",
  "description": "Cubo: isla dinámica para Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.isla.dinamica",
    "productName": "Cubo",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "settings.html",
      "notes.html",
      "shared.js",
      "shared.css",
      "ps/**",
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "artifactName": "Cubo-Setup.${ext}",
    "afterAllArtifactBuild": "build-hooks.js"
  },
  "author": "Isla Dinamica"
}